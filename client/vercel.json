{
  "redirects": [
    {
      "source": "/(.*).aspx",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Arkiv/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/Default.aspx",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/send-email.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}